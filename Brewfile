tap "homebrew/bundle"

# Core shell / dev
brew "git"                        # version control
brew "gh"                         # GitHub CLI
brew "chezmoi"                    # dotfiles manager
brew "starship"                   # cross-shell prompt
brew "tmux"                       # terminal multiplexer

# Python / dev workflow
brew "just"                       # command runner (Makefile alternative)
brew "node"                       # Node.js + npm

# Modern Unix replacements
brew "bat"                        # better cat (syntax highlighting)
brew "eza"                        # better ls
brew "fzf"                        # fuzzy finder
brew "ripgrep"                    # rg (better grep)
brew "fd"                         # better find
brew "jq"                         # JSON processor
brew "wget"                       # HTTP downloader
brew "pandoc"                     # universal document converter

# Shell enhancements
brew "zsh-autosuggestions"        # fish-style command suggestions
brew "zsh-syntax-highlighting"    # fish-style syntax highlighting

# Git tooling
brew "delta"                      # syntax-highlighted diffs

# System monitoring
brew "asitop"                     # Apple Silicon performance monitor
brew "btop"                       # resource monitor with TUI
brew "htop"                       # interactive process viewer
brew "mactop"                     # macOS-specific system monitor
brew "llmfit"                     # identify best local LLMs for current hardware

# macOS productivity
cask "iterm2"                     # macOS terminal emulator
cask "raycast"                    # launcher
cask "bartender"                  # menu bar icon organizer
cask "hammerspoon"                # macOS automation via Lua
cask "karabiner-elements"         # key remapping — enables hyper key for Hammerspoon

# Dev tools
cask "visual-studio-code@insiders" # VS Code (bleeding-edge Insiders build)
cask "docker"                     # container runtime
cask "orbstack"                   # Docker alternative / VM manager
cask "rectangle"                  # window manager

# Fonts (required for eza --icons)
cask "font-fira-code-nerd-font"   # monospace font with icons for eza + starship

# Apps
cask "obsidian"                   # knowledge base + note-taking
cask "ollama-app"                 # Ollama GUI
cask "dropbox"                    # cloud file sync
cask "vivaldi"                    # Chromium browser with power-user features
cask "signal"                     # encrypted messaging
cask "slack"                      # team communication
cask "zoom"                       # video conferencing
cask "lm-studio"                  # local LLM GUI runner
cask "tailscale-app"              # VPN mesh
